{
  "buildCommand": "npm run vercel-build",
  "cleanUrls": true,
  "framework": "vite",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "{dist/index.html,server/assets/**}"
    }
  },
  "installCommand": "npm ci",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "destination": "/api",
      "source": "/api/(.*)"
    },
    {
      "destination": "/api",
      "source": "/uploads/(.*)"
    },
    {
      "destination": "/api",
      "source": "/jobs/:id"
    },
    {
      "destination": "/api",
      "source": "/p/:slug"
    },
    {
      "destination": "/api",
      "source": "/sitemap.xml"
    },
    {
      "destination": "/index.html",
      "source": "/(.*)"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self'; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/import-jobs",
      "schedule": "37 12 * * *"
    },
    {
      "path": "/api/cron/import-jobs?run=2",
      "schedule": "52 12 * * *"
    },
    {
      "path": "/api/cron/import-jobs?run=3",
      "schedule": "22 13 * * *"
    },
    {
      "path": "/api/cron/import-jobs?run=4",
      "schedule": "47 13 * * *"
    },
    {
      "path": "/api/cron/job-alerts",
      "schedule": "7 14 * * *"
    },
    {
      "path": "/api/cron/import-jobs?run=5",
      "schedule": "37 18 * * *"
    },
    {
      "path": "/api/cron/import-jobs?run=6",
      "schedule": "7 21 * * *"
    }
  ]
}
