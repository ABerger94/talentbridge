{
  "buildCommand": "npm run vercel-build",
  "cleanUrls": true,
  "framework": "vite",
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "installCommand": "npm ci",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "destination": "/api",
      "source": "/api/(.*)"
    },
    {
      "destination": "/api",
      "source": "/uploads/(.*)"
    },
    {
      "destination": "/index.html",
      "source": "/(.*)"
    }
  ]
}
